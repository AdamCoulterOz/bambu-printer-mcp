# Copy outside the repository to a protected local file before changing values.
# Every path below is dummy metadata, not a live host path or credential.
AUTH_IMAGE=local/bambu-mcp-auth:checkpoint
SLICER_SOCKET_GID=10001
MCP_PUBLIC_ORIGIN=https://gateway.example.invalid
MCP_TRUSTED_HOST=gateway.example.invalid
MCP_TENANT_ID=11111111-1111-1111-1111-111111111111
MCP_ENTRA_CLIENT_ID=22222222-2222-2222-2222-222222222222
MCP_ALLOWED_OID=33333333-3333-3333-3333-333333333333
MCP_PRINTER_BACKEND_URL=http://127.0.0.1:8189/3d-printing
MCP_PRINTER_STATE_DIR=/srv/bambu-mcp-auth/printer-state
SLICER_STATE_DIR=/srv/bambu-mcp-auth/slicer-state
SLICER_SOCKET_DIRECTORY=/srv/bambu-slicer/socket
MCP_ENTRA_SECRET_HOST_FILE=/srv/bambu-mcp-auth/secrets/entra-secret
MCP_JWT_KEY_HOST_FILE=/srv/bambu-mcp-auth/secrets/printer-jwt-key
MCP_STORAGE_KEY_HOST_FILE=/srv/bambu-mcp-auth/secrets/printer-storage-key
MCP_BACKEND_TOKEN_HOST_FILE=/srv/bambu-mcp-auth/secrets/printer-backend-bearer
SLICER_JWT_KEY_HOST_FILE=/srv/bambu-mcp-auth/secrets/slicer-jwt-key
SLICER_STORAGE_KEY_HOST_FILE=/srv/bambu-mcp-auth/secrets/slicer-storage-key
SLICER_BACKEND_TOKEN_HOST_FILE=/srv/bambu-mcp-auth/secrets/slicer-backend-bearer
