# Values are deployment identifiers and paths, not credentials. Keep the real
# secret and launcher files outside Git and mode-restrict them before use.
BAMBU_IMAGE=sha256:7144ac0001d10de14335950464fc563eea8ebd60aef6c4faf5c1a61779f99c7e
BAMBU_NETWORK_MODE=bambu-printer-mcp-egress
BAMBU_HOME_DIR=/DATA/AppData/bambu-printer-mcp/<managed-instance>/home-node
BAMBU_SECRETS_DIR=/DATA/AppData/bambu-printer-mcp/<managed-instance>/bambu-secrets
BAMBU_RUNTIME_ENV_FILE=/DATA/AppData/bambu-printer-mcp/zimaos-adapter/runtime-env.sh
BAMBU_NATIVE_LAUNCHER_FILE=/DATA/.local/<private-native-source>/direct-launch.sh
BAMBU_HANDY_APK_FILE=/DATA/.local/<private-native-source>/handy.apk
BAMBU_TUTK_LOCK_DIR=/DATA/AppData/bambu-tutk-runtime/locks
ARTIFACT_STORE_DIR=/DATA/AppData/bambu-file-exchange/store
ARTIFACT_OUTBOX_DIR=/DATA/AppData/bambu-file-exchange/outbox

ORCA_IMAGE=sha256:3fddb1d70090cc0042aa7c93f0319479a1c911c474c2ae22bab54b39e7798376
ORCA_GATEWAY_HOST=YOUR_MCP_HOST
ORCA_STATE_DIR=/DATA/AppData/bambu-slicer/state
ORCA_ARTIFACT_DIR=/DATA/AppData/bambu-slicer/artifacts
ORCA_SOCKET_DIR=/DATA/AppData/bambu-slicer/socket
ORCA_TOKEN_FILE=/DATA/AppData/bambu-slicer/private/orca-token
ARTIFACT_GROUP_GID=10002
